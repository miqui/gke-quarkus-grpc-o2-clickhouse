# 1Password CLI environment for the GKE scripts.
#
# Usage:
#   1. Copy this file to .env:
#      cp .env.example .env
#   2. Update the op:// URIs to match your 1Password vault, item, and field names:
#      op://<vault>/<item>/<field>
#   3. Run the scripts that need these through `op run`:
#      op run --env-file=.env -- env PROJECT_ID=k8s-dev-412419 ./gke-secrets-seed.sh
#      op run --env-file=.env -- env PROJECT_ID=k8s-dev-412419 ./gke-deploy.sh     # DNS automation
#      op run --env-file=.env -- env PROJECT_ID=k8s-dev-412419 ./gke-teardown.sh   # DNS cleanup
#
# The cluster itself never sees this file: gke-secrets-seed.sh copies the in-cluster secrets into
# GCP Secret Manager, and External Secrets reads them from there.

# --- Copied to Secret Manager by gke-secrets-seed.sh ---------------------------------------------

# Cloud SQL application user password (the user name is fixed: message_app, see k8s/postgres.yaml)
DB_PASSWORD="op://dev-vault/k8s-postgres/password"

# Grafana admin
GF_SECURITY_ADMIN_USER="op://dev-vault/k8s-grafana/username"
GF_SECURITY_ADMIN_PASSWORD="op://dev-vault/k8s-grafana/password"

# OpenObserve root user (also what Prometheus remote_write and the OTel collectors log in as)
ZO_ROOT_USER_EMAIL="op://dev-vault/k8s-openobserve/username"
ZO_ROOT_USER_PASSWORD="op://dev-vault/k8s-openobserve/password"

# ClickHouse `default` user (k8s/clickhouse/) - also what otel-collector-clickhouse writes as
CLICKHOUSE_DEFAULT_PASSWORD="op://dev-vault/k8s-clickhouse/password"

# --- Used only by gke-deploy.sh / gke-teardown.sh on your machine ---------------------------------

# Cloudflare API token scoped to Zone -> DNS -> Edit for miqui.dev only. Optional: without it the
# scripts print the DNS records to add/remove by hand.
CLOUDFLARE_API_TOKEN="op://dev-vault/cloudflare-miqui-dev/credential"
